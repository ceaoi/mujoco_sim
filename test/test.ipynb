   "source": [
    "from math import tan\n",
    "from math import atan2\n",
    "\n",
    "targ_vx = -0.46\n",
    "max_angle = -2.9\n",
    "\n",
    "vy_omega = -0.56\n",
    "max_vy = targ_vx * tan(max_angle) - vy_omega"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "56c247b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "targ_vy = max_vy + vy_omega\n",
    "targ_angle = atan2(targ_vy, targ_vx)"
   ]
  }
 ],
