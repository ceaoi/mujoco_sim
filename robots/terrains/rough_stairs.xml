<mujoco model="rough_terrain">

    <default>
        <default class="terrain">
            <geom contype="1" conaffinity="1" condim="3"
                  friction="1 0.01 0.01" group="0"/>
        </default>
    </default>

    <worldbody>
        <!-- ===== Flat ground before stairs ===== -->
        <geom name="ground_start" class="terrain"
              type="box" size="1.0 4.0 0.03" pos="-0.5 0 0.03"
              rgba="0.45 0.50 0.55 1"/>

        <!-- ===== Low stairs: 5 steps ascending, 0.08m rise, 0.30m deep ===== -->
        <geom name="stair_a1" class="terrain"
              type="box" size="0.15 4.0 0.04" pos="0.50 0 0.04"
              rgba="0.55 0.50 0.45 1"/>
        <geom name="stair_a2" class="terrain"
              type="box" size="0.15 4.0 0.08" pos="0.80 0 0.08"
              rgba="0.50 0.45 0.40 1"/>
        <geom name="stair_a3" class="terrain"
              type="box" size="0.15 4.0 0.12" pos="1.10 0 0.12"
              rgba="0.45 0.40 0.35 1"/>
