              type="box" size="0.15 4.0 0.16" pos="1.40 0 0.16"
              rgba="0.40 0.35 0.30 1"/>
        <geom name="stair_a5" class="terrain"
              type="box" size="0.15 4.0 0.20" pos="1.70 0 0.20"
              rgba="0.35 0.30 0.25 1"/>

        <!-- Low platform: 2m long, 0.40m high -->
        <geom name="platform_low" class="terrain"
              type="box" size="1.0 4.0 0.20" pos="2.85 0 0.20"
              rgba="0.35 0.45 0.35 1"/>

        <!-- Low stairs: 5 steps descending -->
        <geom name="stair_d1" class="terrain"
              type="box" size="0.15 4.0 0.20" pos="4.00 0 0.20"
