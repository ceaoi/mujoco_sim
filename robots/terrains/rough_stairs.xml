        <geom name="ground_mid" class="terrain"
              type="box" size="2.0 4.0 0.03" pos="7.35 0 0.03"
              rgba="0.45 0.50 0.55 1"/>

        <!-- ===== Tall stairs: 5 steps ascending, 0.15m rise, 0.30m deep ===== -->
        <geom name="stair_ta1" class="terrain"
              type="box" size="0.15 4.0 0.075" pos="12.00 0 0.075"
              rgba="0.60 0.40 0.30 1"/>
        <geom name="stair_ta2" class="terrain"
